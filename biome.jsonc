{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  // Off on purpose. Biome moves a comment along with the import it precedes, so sorting drags each
  // file's header comment (the one describing the whole module) down into the middle of the import
  // block, where it reads as an annotation on whichever import happens to sort above it. Enabling
  // it did that to 53 files, including broker.ts, orchestrator.ts and gates.ts. Alphabetical
  // imports are not worth losing the file headers.
  "organizeImports": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        // The codebase uses `!` where an invariant is already established (often right after a
        // guard), and noUncheckedIndexedAccess makes those common. Silencing the guard would be
        // worse than the assertion.
        "noNonNullAssertion": "off"
      }
    }
  },
  // Read .gitignore. Without this biome lints build output: parent-guide/out alone accounted for
  // 19,676 of 19,788 reported errors and 50 of 53 seconds of runtime, which made the linter
  // useless to anyone who ran it.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": [
      "**/dist/**",
      "**/.next/**",
      "**/out/**",
      "**/build/**",
      "**/coverage/**",
      "**/node_modules/**",
      "**/*.d.ts",
      "passion/apps/**/tsconfig.json"
    ]
  }
}
